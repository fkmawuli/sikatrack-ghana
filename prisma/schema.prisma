// KudiTrack - Prisma schema (PostgreSQL / Supabase).
// Money fields use Decimal(12,2) GHS. Quantity fields use Decimal(12,3) to allow
// fractional units (kg, litre) as well as whole units (piece, pack).
// SQLite (file:./dev.db) also works for local dev with zero setup, but native
// decimal precision (@db.Decimal / @db.Date below) is Postgres-only syntax and
// must be dropped if you switch the provider back to "sqlite".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  STOCK_KEEPER
  BOOKKEEPER
}

enum PaymentMethod {
  CASH
  MOMO
  BANK_TRANSFER
}

enum StockMovementType {
  OPENING
  RECEIVED
  SALE
  RETURN
  DAMAGED
  EXPIRED
  MISSING
  ADJUSTMENT
  CORRECTION
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  PARTIALLY_RETURNED
  FULLY_RETURNED
}

enum ReturnType {
  CANCELLATION
  PARTIAL_RETURN
  FULL_RETURN
  EXCHANGE
}

enum ReconciliationStatus {
  PENDING
  APPROVED
}

model Business {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  location      String?
  email         String?
  logoUrl       String?
  taxId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  settings        BusinessSettings?
  users           User[]
  categories      Category[]
  suppliers       Supplier[]
  products        Product[]
  stockMovements  StockMovement[]
  sales           Sale[]
  expenses        Expense[]
  expenseCategories ExpenseCategory[]
  returns         Return[]
  reconciliations Reconciliation[]
  auditLogs       AuditLog[]
}

model BusinessSettings {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currencyCode          String   @default("GHS")
  timezone              String   @default("Africa/Accra")
  openingHour           Int      @default(8)
  closingHour           Int      @default(20)
  negativeStockAllowed  Boolean  @default(false)
  lowStockAlertEnabled  Boolean  @default(true)
  defaultReceiptSize    String   @default("80mm")
  showReprintLabel      Boolean  @default(true)
  receiptFooterMessage  String?  @default("Thank you for your business!")
  returnPolicy          String?
  taxEnabled            Boolean  @default(false)
  taxRate               Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt             DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         UserRole
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  salesAsCashier   Sale[]           @relation("CashierSales")
  stockMovements   StockMovement[]
  expenses         Expense[]
  returnsRequested Return[]         @relation("ReturnRequestedBy")
  returnsApproved  Return[]         @relation("ReturnApprovedBy")
  reconciliationsCreated  Reconciliation[] @relation("ReconCreatedBy")
  reconciliationsApproved Reconciliation[] @relation("ReconApprovedBy")
  auditLogs        AuditLog[]

  @@index([businessId])
}

model Category {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]

  @@unique([businessId, name])
}

model Supplier {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  address    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]

  @@index([businessId])
}

model Product {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sku           String
  barcode       String?
  name          String
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  unit          String    @default("piece")
  costPrice     Decimal   @db.Decimal(12, 2)
  sellingPrice  Decimal   @db.Decimal(12, 2)
  stockQty      Decimal   @default(0) @db.Decimal(12, 3)
  reorderLevel  Decimal   @default(5) @db.Decimal(12, 3)
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  imageUrl      String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([businessId, barcode])
  @@index([businessId, active])
}

model StockMovement {
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId        String
  product          Product           @relation(fields: [productId], references: [id])
  type             StockMovementType
  quantity         Decimal           @db.Decimal(12, 3) // signed delta
  previousBalance  Decimal           @db.Decimal(12, 3)
  newBalance       Decimal           @db.Decimal(12, 3)
  referenceNumber  String?
  reason           String?
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  createdAt        DateTime          @default(now())

  @@index([businessId, productId])
  @@index([businessId, createdAt])
}

model Sale {
  id              String     @id @default(cuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  receiptNumber   String     @unique
  cashierId       String
  cashier         User       @relation("CashierSales", fields: [cashierId], references: [id])
  customerName    String?
  customerPhone   String?
  note            String?
  subtotal        Decimal    @db.Decimal(12, 2)
  discountAmount  Decimal    @default(0) @db.Decimal(12, 2)
  discountReason  String?
  totalAmount     Decimal    @db.Decimal(12, 2)
  amountReceived  Decimal    @db.Decimal(12, 2)
  changeGiven     Decimal    @default(0) @db.Decimal(12, 2)
  status          SaleStatus @default(COMPLETED)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  items    SaleItem[]
  payments Payment[]
  returns  Return[]

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, cashierId])
}

model SaleItem {
  id                String   @id @default(cuid())
  saleId            String
  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  productName       String
  quantity          Decimal  @db.Decimal(12, 3)
  unitPrice         Decimal  @db.Decimal(12, 2)
  costPriceAtSale   Decimal  @db.Decimal(12, 2)
  lineDiscount      Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal  @db.Decimal(12, 2)
  returnedQuantity  Decimal  @default(0) @db.Decimal(12, 3)

  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  createdAt DateTime      @default(now())

  @@index([saleId])
}

model ExpenseCategory {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  isSystem   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  expenses   Expense[]

  @@unique([businessId, name])
}

model Expense {
  id                  String          @id @default(cuid())
  businessId          String
  business            Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId          String
  category            ExpenseCategory @relation(fields: [categoryId], references: [id])
  description         String
  amount              Decimal         @db.Decimal(12, 2)
  paymentMethod       PaymentMethod
  payee               String?
  referenceNumber     String?
  receiptUrl          String?
  isPersonalWithdrawal Boolean        @default(false)
  userId              String
  user                User            @relation(fields: [userId], references: [id])
  expenseDate         DateTime
  createdAt           DateTime        @default(now())

  @@index([businessId, expenseDate])
}

model Return {
  id               String     @id @default(cuid())
  businessId       String
  business         Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleId           String
  sale             Sale       @relation(fields: [saleId], references: [id])
  type             ReturnType
  reason           String
  refundAmount     Decimal    @default(0) @db.Decimal(12, 2)
  requestedByUserId String
  requestedBy      User       @relation("ReturnRequestedBy", fields: [requestedByUserId], references: [id])
  approvedByUserId String
  approvedBy       User       @relation("ReturnApprovedBy", fields: [approvedByUserId], references: [id])
  createdAt        DateTime   @default(now())

  items ReturnItem[]

  @@index([businessId, saleId])
}

model ReturnItem {
  id         String   @id @default(cuid())
  returnId   String
  return     Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])
  quantity   Decimal  @db.Decimal(12, 3)
  restocked  Boolean  @default(true)

  @@index([returnId])
}

model Reconciliation {
  id                    String               @id @default(cuid())
  businessId            String
  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date                  DateTime             @db.Date
  openingCash           Decimal              @db.Decimal(12, 2)
  expectedCashSales     Decimal              @db.Decimal(12, 2)
  expectedMomo          Decimal              @db.Decimal(12, 2)
  expectedBank          Decimal              @db.Decimal(12, 2)
  cashExpenses          Decimal              @db.Decimal(12, 2)
  cashRefunds           Decimal              @db.Decimal(12, 2)
  expectedClosingCash   Decimal              @db.Decimal(12, 2)
  actualCashCounted     Decimal?             @db.Decimal(12, 2)
  actualMomoBalance     Decimal?             @db.Decimal(12, 2)
  variance              Decimal?             @db.Decimal(12, 2)
  cashierNotes          String?
  status                ReconciliationStatus @default(PENDING)
  createdByUserId       String
  createdBy             User                 @relation("ReconCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUserId       String?
  approvedBy             User?                @relation("ReconApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt             DateTime?
  createdAt              DateTime             @default(now())

  @@unique([businessId, date])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, entityType])
}
